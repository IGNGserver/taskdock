NODE_ENV=development
APP_VERSION=0.1.0
# Docker 默认对外 HTTP 端口；应用容器内部仍监听 APP_PORT
TASKDOCK_PORT=48731
APP_PORT=3000
APP_ORIGIN=http://localhost:48731
# 内置 PostgreSQL（compose.yaml）：应用通过 PGHOST/PGUSER/PGPASSWORD/PGDATABASE
# 连接，密码不需要 URL 编码。
POSTGRES_DB=devtodo
POSTGRES_USER=devtodo
POSTGRES_PASSWORD=replace-with-a-database-password
# 外部 PostgreSQL（compose.external-db.yaml）：填写完整 URL，并删除/忽略上面的
# POSTGRES_*。每个 TaskDock 中枢必须使用独立 database；只共享服务器，不共享库。
# DATABASE_URL=postgres://taskdock_app:replace-me@db.example.lan:5432/taskdock
# 可选：迁移专用 DDL 角色；为空时复用 DATABASE_URL。
# MIGRATION_DATABASE_URL=postgres://taskdock_migrator:replace-me@db.example.lan:5432/taskdock
# DATABASE_SSL_MODE=verify-full
# DATABASE_SSL_CA=/run/secrets/db-ca.pem
DB_POOL_MAX=10
DB_POOL_WARM=0
DB_APPLICATION_NAME=taskdock-api
# PgBouncer transaction mode 不能保持 LISTEN 会话；此时设为 false。
DB_LISTEN_ENABLED=true
DB_CONNECT_TIMEOUT_MS=5000
# 远端库建议不要 30 秒就回收空闲连接。
DB_IDLE_TIMEOUT_MS=300000
DB_QUERY_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
# 启动时数据库未就绪的最长等待时间；0 表示只尝试一次。
DB_STARTUP_MAX_WAIT_MS=60000
# 迁移可能包含大表 backfill，默认给 5 分钟。
MIGRATION_STATEMENT_TIMEOUT_MS=300000
BOOTSTRAP_TOKEN=replace-with-at-least-32-random-bytes
# 首次部署时由部署中枢使用；客户端不会要求填写此令牌
OWNER_USERNAME=owner
OWNER_PASSWORD=replace-with-a-password-of-at-least-6-characters
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_PEPPER=replace-with-a-long-random-pepper
# refresh session 的滑动不活动窗口（天）；每次 refresh 续期，0 表示不按时间过期。
# Web 端仍受浏览器对持久 Cookie 的约 400 天上限约束。
REFRESH_TOKEN_IDLE_TTL_DAYS=365
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
NATIVE_ALLOWED_ORIGINS=capacitor://localhost,https://localhost,http://localhost
LOG_LEVEL=info
TRUST_PROXY=0
# 登录尝试上限：每个「客户端地址 + 用户名」在固定 15 分钟窗口内允许的登录次数。
# 大量用户共享同一出口地址（NAT、企业代理）时可适当调高；生产环境不得超过 1000。
AUTH_LOGIN_RATE_LIMIT=10
SYNC_CHANGE_RETENTION_DAYS=90
MUTATION_RECEIPT_RETENTION_DAYS=90
# 可选 Redis（compose.yaml 使用 --profile cache，或指向外部 Redis）。
# 缓存故障时自动回退到进程内缓存/数据库，不影响写入。
# CACHE_URL=redis://redis:6379/0
# CACHE_KEY_PREFIX=taskdock-home
# CACHE_SNAPSHOT_TTL_SECONDS=60
# CACHE_REQUIRED=false
# CACHE_TLS_CA=/run/secrets/redis-ca.pem
DEV_MEMORY_STORE=true
